# ─────────────────────────────────────────────
# Environment Variables — Wasla WhatsApp Server
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://qigdwhuzujujxaeupboo.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Server
PORT=3000
SESSION_NAME=wasla_main

# Security — مفتاح للتحقق من الطلبات الواردة
BAILEYS_API_KEY=your_strong_secret_key_here

# Rate Limiting (اختياري — القيم الافتراضية موصى بها)
RATE_LIMIT_PER_MIN=20
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000
