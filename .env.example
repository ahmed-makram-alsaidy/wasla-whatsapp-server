# ─────────────────────────────────────────────────────────
# Wasla WhatsApp Server — environment (NAMES ONLY, never commit values)
# ─────────────────────────────────────────────────────────

# Supabase (business-truth project)
SUPABASE_URL=https://qigdwhuzujujxaeupboo.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Server
PORT=3000

# Security — REQUIRED. Server refuses to start without it.
BAILEYS_API_KEY=your_strong_secret_key_here

# Persistent Baileys auth state directory (mount a host volume here)
AUTH_SESSIONS_DIR=/app/auth_sessions

# Optional: browser origins allowed to call this server directly.
# Leave EMPTY for pure server-to-server topology (recommended after the
# admin gateway Edge Function is deployed).
ALLOWED_ORIGINS=

# Compatibility only: maps legacy /status /qr /send-group routes to ONE
# operator-designated session id (a real platform company UUID).
# Never used for tenant routing.
PLATFORM_COMPANY_ID=

# Rate limiting (global ceiling; per-company fairness is built-in)
RATE_LIMIT_PER_MIN=20
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000

# Startup/shutdown tuning
RESTORE_JITTER_MS=1500
SHUTDOWN_DRAIN_MS=8000

NODE_ENV=production
